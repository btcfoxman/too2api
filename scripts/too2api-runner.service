[Unit]
Description=GitHub Actions runner for TOO2API pre-production
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/btcfoxman/actions-runners/repo-too2api
ExecStart=/home/btcfoxman/actions-runners/repo-too2api/runsvc.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
